{
  "name": "@morewax/dsh-spec-ptc",
  "version": "0.1.0",
  "description": "Speculative programmatic tool calling (sPTC) for DeepSeek Harness \u2014 pre-runs tool calls during model generation via the upstream spec-ptc daemon",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./bindings": "./lib/bindings.js",
    "./python-runtime": "./lib/python-runtime.js"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "python",
    "python-runtime"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "speculative-execution",
    "programmatic-tool-calling",
    "rlm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-spec-ptc.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/bindings.ts src/python-runtime.ts --format esm --dts --out-dir lib",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:shim": "uv run --project python --locked --no-dev python -m py_compile python/dsh_spec_engine.py",
    "test:python": "uv run --project python-runtime --locked --no-dev python -m py_compile python-runtime/bootstrap.py"
  },
  "dependencies": {
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-code-runtime-python": "0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.0",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime-python": "0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
